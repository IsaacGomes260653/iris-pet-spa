# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# imagens de referência (capturas de sites de terceiros e fotos pessoais): só locais
docs/referencias/

# segredos (nunca vão para o GitHub)

# originais em alta da mídia, vídeos brutos e renders do Blender (baixáveis de novo pelo CREDITS.md)
media-src/
midia-gerada/
*.blend
*.blend1

# capturas de tela das fases (ficam fora do Git)
capturas/

# cache do Python (scripts que importam render/montar.py)
__pycache__/
